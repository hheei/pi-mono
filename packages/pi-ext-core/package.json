{
	"name": "@hheei/pi-ext-core",
	"version": "0.8.2",
	"description": "Shared lifecycle and coordination primitives for independent Pi extensions.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"default": "./dist/errors.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"extension-core"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/pi-mono.git",
		"directory": "packages/pi-ext-core"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.5.0",
		"@earendil-works/pi-coding-agent": ">=1.5.0",
		"@earendil-works/pi-tui": ">=1.5.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.5.0",
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@earendil-works/pi-tui": "^1.5.0"
	}
}
